0000
,  // measure 2: taps on beats 8 (as the BPM changes to 240) and 10, a hold from 9, and its end alone on 11
0001
2000
0100
3000
,  // measure 3: a tap on beat 12, and a mine alone on 14
0010
0000
000M
0000
,  // measure 4: taps on beats 16 (as the BPM changes to 180) and 17
1000
0001
0000
0000
,  // measure 5: empty
0000
0000
0000
0000
;

