// Test .ssc file for ddr-trainer's loader, written for it rather than taken from a real
// song. Generated by test_resources/make_test_simfiles.py, so edit that instead of this.
// It starts with a byte order mark and is laid out the way StepMania 5 saves .ssc files
// (CRLF line endings, a #NOTEDATA block of tags for each chart), with every timing tag
// StepMania writes, empty or at its default. Its charts:
//   Beginner: no timing of its own, so the song's
//   Easy: only BPMs of its own, as in DDR packs, so none of the song's stops
//   Medium: BPMs, stops and time signatures of its own (time signatures only move measure
//     lines)
//   skipped: an Edit chart, and a pump-single chart with stops but no BPMs of its own
//   a dance-double chart with timing of its own
// Loading the folder "Split Timing" should find this file, since it has the same name.
#VERSION:0.83;
#TITLE:Split Timing;
#SUBTITLE:;
#ARTIST:ddr-trainer;
#TITLETRANSLIT:;
#SUBTITLETRANSLIT:;
#ARTISTTRANSLIT:;
#GENRE:;
#ORIGIN:;
#CREDIT:;
#BANNER:Split Timing.png;
#BACKGROUND:;
#PREVIEWVID:;
#JACKET:;
#CDIMAGE:;
#DISCIMAGE:;
#LYRICSPATH:;
#CDTITLE:;
#MUSIC:Split Timing.ogg;
#SAMPLESTART:30.000000;
#SAMPLELENGTH:12.000000;
#SELECTABLE:YES;
#DISPLAYBPM:120.000000:240.000000;
#OFFSET:-0.250000;
#BPMS:0.000000=120.000000,8.000000=240.000000;
#STOPS:4.000000=0.500000;
#DELAYS:;
#WARPS:;
#TIMESIGNATURES:0.000000=4=4;
#TICKCOUNTS:0.000000=4;
#COMBOS:0.000000=1;
#SPEEDS:0.000000=1.000000=0.000000=0;
#SCROLLS:0.000000=1.000000;
#FAKES:;
#LABELS:0.000000=Song Start;
#BGCHANGES:;
#KEYSOUNDS:;
#ATTACKS:;

