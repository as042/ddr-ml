// Formatting quirks for ddr-trainer's .sm loader. Generated by
// test_resources/make_test_simfiles.py, so edit that instead of this. This file starts
// with a UTF-8 byte order mark, uses LF line endings, and leaves out every tag the loader
// can do without (artist transliteration, banner, background, CD title, offset, sample
// start and length, background stage), so those should load as empty or zero.
#TITLE:Re:Quirks #2;#ARTIST:Nobody;
#MUSIC:  quirks.ogg  ;  // a comment after a tag
#BPMS:0.000000=150.000000
,64.000000=300.000000
,96.500000=150.000000
;
#STOPS:
;
#NOTES:
	dance-single:
	Made By Hand:
	challenge:
	10:
	0.5,0.5,0.5,0.5,0.5:
1000
0100  

0010
0001
,  // a comment after a measure separator
1111
0000
;// a comment after the end of the chart
