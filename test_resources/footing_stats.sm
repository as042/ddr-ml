// Test simfile with hand-worked durations and footings, for calibrating ddr-trainer's chart
// analyzer (src/chart_analyzer.rs), whose tests check the values below. Generated by
// test_resources/make_test_simfiles.py, so edit that instead of this.
//
// One BPM (120, so quarter notes are 0.5 s apart and 8ths 0.25 s), no stops.
//   - the duration runs from the chart's first object (a note, mine or hold end) to its last,
//     and the active ratio is the fraction of it between notes at most 1 s apart, or holding
//   - the foot simulation splits the notes into segments at gaps longer than 0.5 s, so quarter
//     notes stay in one. Each segment starts with the feet at home (left foot on Left, right
//     on Right) and gets the cheapest footing by the simulation's costs. The tests use fixed
//     ones (TEST_COSTS in src/chart_analyzer/footing.rs), where an event costs its base plus
//     its speed cost times how fast the notes are (1 for notes 0.125 s apart, so 0.25 for
//     quarter notes here and 0.5 for 8ths): a horizontal crossover 4 + 1 x speed, a doublestep
//     1 + 7 x speed, a bracket 6 + 1 x speed, a full spin 16 + 4 x speed
//
//   chart      duration  active  doublesteps  brackets  staircases
//   Beginner   0         0       0            0         0           nothing in it
//   Easy       7         1/2     0            0         1           duration
//   Medium     3.5       4/7     2            0         0           breaks reset
//   Hard       2.75      6/11    0            0         0           either foot starts
//   Challenge  6         7/12    2            1         0           realistic mix
//
// Every other event and pattern count is 0 in every chart.
// Easy: 2 s to 9 s (a mine), active from 2 s to 5.5 s (quarter notes, then a hold). Left, Down,
//   Up, Right is a staircase, however slow.
// Medium: Left, Down, Right in quarter notes, twice, with a 1.5 s break between. Alternating
//   would cross the left foot over to Right (4.25). The right foot stepping Down then Right is
//   a doublestep (2.75), which is cheaper this slow. The feet go home in the break.
// Hard: Up, Left, Up, Left crosses over if the left foot starts, so the right foot does, and
//   after a break Up, Right, Up, Right crosses over if the right foot starts, so the left does.
// Challenge: Left, Down, Right, Up, Left, Down in 8ths alternates into a crossover and a full
//   spin (22.5). Two doublesteps (4.5 each) get round the pad without turning. Then Up, Left,
//   Up, Left as in Hard. Then a hold on Left with Down, Up, Down under it: the right foot would
//   doublestep twice (9), so the left foot taps Up while it holds Left, a bracket (6.5), and
//   the right foot stays on Down.
#TITLE:Footing Stats;
#ARTIST:ddr-trainer;
#MUSIC:footing_stats.ogg;
#OFFSET:0.000000;
#BPMS:0.000=120.000;
#STOPS:;

//---------------dance-single - nothing in it----------------
#NOTES:
     dance-single:
     nothing in it:
     Beginner:
     1:
     0.412,0.356,0.250,0.100,0.000:
// measure 0: empty
0000
0000
0000
0000
,  // measure 1: empty
0000
0000
0000
0000
;

//---------------dance-single - duration----------------
#NOTES:
     dance-single:
     duration:
     Easy:
     2:
     0.412,0.356,0.250,0.100,0.000:
// measure 0: empty
0000
0000
0000
0000
,  // measure 1: quarter notes from 2 s
1000
0100
0010
0001
,  // measure 2: a hold from 4 s to 5.5 s
2000
0000
0000
3000
,  // measure 3: empty, a break
0000
0000
0000
0000
,  // measure 4: a tap at 8 s, and a mine at 9 s that ends the chart
1000
0000
000M
0000
,  // measure 5: empty
0000
0000
0000
0000
;

//---------------dance-single - breaks reset----------------
#NOTES:
     dance-single:
     breaks reset:
     Medium:
     4:
     0.412,0.356,0.250,0.100,0.000:
// measure 0: Left, Down, Right in quarter notes: a doublestep
1000
0100
0001
0000
,  // measure 1: after a 1.5 s break, the same again
0000
1000
0100
0001
;

//---------------dance-single - either foot starts----------------
#NOTES:
     dance-single:
     either foot starts:
     Hard:
     6:
     0.412,0.356,0.250,0.100,0.000:
// measure 0: Up, Left, Up, Left in 8ths, started by the right foot
0010
1000
0010
1000
0000
0000
0000
0000
,  // measure 1: after a 1.25 s break, Up, Right, Up, Right, started by the left foot
0010
0001
0010
0001
0000
0000
0000
0000
;

//---------------dance-single - realistic mix----------------
#NOTES:
     dance-single:
     realistic mix:
     Challenge:
     9:
     0.412,0.356,0.250,0.100,0.000:
// measure 0: Left, Down, Right, Up, Left, Down in 8ths: two doublesteps
1000
0100
0001
0010
1000
0100
0000
0000
,  // measure 1: after a 1.25 s break, Up, Left, Up, Left, started by the right foot
0000
0000
0010
1000
0010
1000
0000
0000
,  // measure 2: after a 1.25 s break, a hold on Left with Down, Up, Down under it (a bracket), then Up
0000
0000
2000
0100
0010
0100
3000
0010
,  // measure 3: Right
0001
0000
0000
0000
0000
0000
0000
0000
;
