// measure 0: empty
0000
0000
0000
0000
,  // measure 1: empty
0000
0000
0000
0000
,  // measure 2: a jump on beat 10, exactly where the BPM changes to 240
0000
0000
1001
0000
,  // measure 3: empty
0000
0000
0000
0000
;

