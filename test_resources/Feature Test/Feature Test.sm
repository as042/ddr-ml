// Test simfile for ddr-trainer's .sm loader, written for it rather than taken from a real
// song. Generated by test_resources/make_test_simfiles.py, so edit that instead of this.
// It is laid out the way StepMania saves .sm files (CRLF line endings, a comment before
// each chart and after each measure separator) and contains:
//   - every header tag SimFile reads, plus tags it ignores (including one with ':' in its
//     value and one that spans two lines)
//   - BPM changes (written over several lines) and stops on fractional beats, and a
//     negative offset
//   - a dance-single chart for each difficulty, each covering different notes:
//       Beginner: taps and jumps         Easy: holds
//       Medium: rolls and mines          Hard: every measure size from 4 to 192 rows
//       Challenge: all of the above mixed together
//   - charts the loader skips: an Edit chart and a pump-single chart
//   - two dance-double charts
// Loading the folder "Feature Test" should find this file, since it has the same name.
#TITLE:Feature Test;
#SUBTITLE:(every tag and note type);
#ARTIST:テスト;
#TITLETRANSLIT:;
#SUBTITLETRANSLIT:;
#ARTISTTRANSLIT:Tesuto;
#GENRE:Test;
#CREDIT:ddr-trainer;
#BANNER:Feature Test.png;
#BACKGROUND:Feature Test-bg.png;
#LYRICSPATH:;
#CDTITLE:./CDTitles/Feature Test.png;
#MUSIC:Feature Test.ogg;
#OFFSET:-0.125000;
#SAMPLESTART:12.345;
#SAMPLELENGTH:15;
#SELECTABLE:YES;
#DISPLAYBPM:60:240;
#BPMS:0.000=120.000,
16.000=240.000,
32.500=60.000,
48.000=120.000;
#STOPS:8.000=0.500,24.250=0.125;
#BGSTAGE:7;
#BGCHANGES:0.000=Feature Test.avi=1.000=0=0=1=====,
99999.000=-nosongbg-=1.000=0=0=0=====;
#KEYSOUNDS:;
#ATTACKS:;

